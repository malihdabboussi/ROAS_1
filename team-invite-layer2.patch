+async function maybeShowPermissionToast(res: Response): Promise<void> {
+  if (res.status !== 403 || typeof window === 'undefined') return
+  try {
+    const body = (await res.clone().json()) as {
+      toast_key?: string
+      params?: Record<string, unknown>
+      message?: string
+      error?: string
+    }
+    const message =
+      formatPermissionToastMessage(body.toast_key, body.params) ??
+      body.message ??
+      body.error ??
+      null
+    if (!message) return
+    const { toast } = await import('sonner')
+    toast.warning(message)
+  } catch {
+    // Ignore parse errors, this is best effort UI feedback.
+  }
+}
