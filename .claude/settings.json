{
  "omc": {
    "deepInterview": {
      "ambiguityThreshold": 0.1
    }
  },
  "permissions": {
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(codex exec:*)",
      "Write(.claude/rules/**)",
      "Edit(.claude/rules/**)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git push --force*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-git.sh"
          }
        ]
      }
    ]
  }
}
