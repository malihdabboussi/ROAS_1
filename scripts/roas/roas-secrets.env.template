# =============================================================================
# ROAS — master secrets template (fill once, paste to Vercel / Fly / Railway)
# =============================================================================
#
# SETUP:
#   cp scripts/roas/roas-secrets.env.template scripts/roas/roas-secrets.env
#   Fill scripts/roas/roas-secrets.env with real values (from LastPass / dashboards)
#
# NEVER commit roas-secrets.env — it is gitignored.
# This .template file stays in git with placeholders only.
#
# After filling, paste sections into:
#   • Vercel → roas-api / roas-web / roas-funnels → Settings → Environment Variables
#   • Fly → roas-runtimes → Secrets
#   • Railway → roas-workers → each service → Variables
#
# Legend:
#   [P2 REQUIRED]  = needed for first production deploy (api + web + basic smoke test)
#   [P2 AGENTS]    = needed for Fly agent-api / OpenClaw / workers
#   [LATER]        = skip until that feature ships
#   → targets      = where to paste this var in production
#
# Provisioning doc: .docs/plans/roas-lovable-rebuild-provisioning.md
# =============================================================================


# =============================================================================
# 1. SUPABASE — roas-production (lhfgtsjetcardinpgouq)
# =============================================================================
# [P2 REQUIRED] → Vercel roas-api, roas-web, roas-funnels | Fly | Railway workers

SUPABASE_URL=https://lhfgtsjetcardinpgouq.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Direct Postgres — Cursor migration scripts + optional API advisory locks
# [P2 REQUIRED for scripts] → scripts/roas/.env (DATABASE_URL only) OR copy here
DATABASE_URL=
# SUPABASE_DIRECT_DB_URL=   # optional pooler URI for API


# =============================================================================
# 2. ROAS PRODUCTION URLS (not secrets — same on all services)
# =============================================================================
# [P2 REQUIRED] → set on Vercel roas-api; use NEXT_PUBLIC_* on web/funnels

APP_URL=https://app.roas.io
API_URL=https://api.roas.io
CORS_ORIGIN=https://app.roas.io
PLATFORM_API_URL=https://api.roas.io
CLOUDFLARE_BASE_DOMAIN=sites.roas.io

# Web / funnels (duplicate Supabase for Next.js public prefix)
NEXT_PUBLIC_SUPABASE_URL=https://lhfgtsjetcardinpgouq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_URL=https://api.roas.io
BACKEND_URL=https://api.roas.io

# MCP (when enabled)
MCP_OAUTH_ISSUER_URL=https://api.roas.io
MCP_RESOURCE_URL=https://mcp.roas.io
MCP_WEB_CONSENT_URL=https://app.roas.io/mcp/consent


# =============================================================================
# 3. SHARED SECRETS — generate together (openssl rand -hex 32 × 3)
# =============================================================================
# [P2 REQUIRED] → MUST match on: Vercel roas-api, Fly roas-runtimes, Railway workers

VAULT_ENCRYPTION_KEY=
INTERNAL_API_TOKEN=
OPENCLAW_GATEWAY_TOKEN=


# =============================================================================
# 4. PLATFORM TOKENS & IDS
# =============================================================================

# [P2 REQUIRED] → Vercel roas-api
VERCEL_TOKEN=
VERCEL_FUNNELS_PROJECT_ID=
VERCEL_TEAM_ID=

# [P2 REQUIRED] → Vercel roas-api (Fly machine pool)
FLY_API_TOKEN=

# [P2 AGENTS] → Railway roas-workers (Redis service — internal URL only)
# Section 4 holds the literal internal URL for reference/scripts.
# Section 10 paste block uses ${{Redis.REDIS_URL}} — use that in Railway Raw Editor.
REDIS_URL=
REDIS_PUBLIC_URL=
REDIS_URL_MISSIONS=

# [P2 AGENTS] → Vercel roas-api (after queue-worker deployed)
# QUEUE_WORKER_URL=https://your-queue-worker.up.railway.app

# [P2 AGENTS] → Vercel roas-api + Fly (set after Fly deploy)
OPENCLAW_GATEWAY_URL=https://roas-runtimes.fly.dev
AGENT_API_URL=https://roas-runtimes.fly.dev


