# Dependencies (installed in Docker)
#
# Fly roas-runtimes needs apps/openclaw + apps/agent-api; this file excludes them
# for slim Railway mission-worker builds. Fly deploy MUST use:
#   bash scripts/roas/deploy-fly-runtimes.sh
# (swaps in docker/fly.dockerignore). Do not run raw flyctl deploy.
# See scripts/roas/README.md
node_modules
**/node_modules

# Build outputs (built in Docker)
**/dist
**/.turbo

# Git
.git
.gitignore
.gitmodules

# IDE
.cursor
.claude
.vscode
**/.DS_Store

# Environment files (secrets passed as env vars)
.env
**/.env
**/.env.*
!**/.env.example

# Logs
*.log
**/*.log

# Test files
**/__tests__
**/*.test.ts
**/*.spec.ts
**/test

# Documentation (not needed in image)
.docs
docs
*.md
!docker/agents/**/*.md

# CI/CD
.github

# Other apps — mission-worker Railway image only needs apps/mission-worker + packages/*
apps/web
apps/admin
apps/site
apps/website
apps/queue-worker
apps/api
apps/agent-api
apps/funnels
apps/openclaw
apps/chrome-extension
apps/docs
Vibey_legacy

# Lockfiles already copied explicitly
!pnpm-lock.yaml
