{
  "name": "@vibey/api-shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ad-canvas-agents": {
      "types": "./dist/ad-canvas-agents.d.ts",
      "require": "./dist/ad-canvas-agents.js",
      "default": "./dist/ad-canvas-agents.js"
    },
    "./ad-strategies": {
      "types": "./dist/ad-strategies.d.ts",
      "require": "./dist/ad-strategies.js",
      "default": "./dist/ad-strategies.js"
    },
    "./image-models": {
      "types": "./dist/image-models.d.ts",
      "require": "./dist/image-models.js",
      "default": "./dist/image-models.js"
    },
    "./observability": {
      "types": "./dist/observability/public.d.ts",
      "require": "./dist/observability/public.js",
      "default": "./dist/observability/public.js"
    },
    "./sanitize-fathom-summary-markdown": {
      "types": "./dist/sanitize-fathom-summary-markdown.d.ts",
      "require": "./dist/sanitize-fathom-summary-markdown.js",
      "default": "./dist/sanitize-fathom-summary-markdown.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "require": "./dist/types/*.js",
      "default": "./dist/types/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@sentry/nestjs": "^10.44.0",
    "@supabase/supabase-js": "^2.49.1",
    "esbuild": "^0.28.0",
    "jose": "^5.10.0",
    "modal": "^0.7.4",
    "pg": "^8.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.12.0",
    "@types/pg": "^8.18.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "reflect-metadata": "^0.2.0"
  }
}
