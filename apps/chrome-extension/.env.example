# Copy to .env and set values, then: pnpm build
# Must match the web app / API you use (same Supabase project as the app).

VITE_VIBEY_APP_ORIGIN=http://localhost:3000
VITE_VIBEY_WEB_ORIGIN=http://localhost:3000
VITE_VIBEY_API_ORIGIN=http://localhost:3001
# Deprecated: chat now goes through VITE_VIBEY_WEB_ORIGIN/api/proxy/chat.
VITE_VIBEY_AGENT_API_ORIGIN=http://localhost:3003
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
