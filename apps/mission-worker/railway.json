{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @vibey/context-breakdown build && pnpm --filter @vibey/api-shared build && pnpm --filter @vibey/mission-worker build",
    "watchPatterns": [
      "apps/mission-worker/**",
      "packages/api-shared/**",
      "packages/context-breakdown/**"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @vibey/mission-worker start:prod",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
