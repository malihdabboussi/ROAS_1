{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/mission-worker/Dockerfile"
  },
  "deploy": {
    "startCommand": "node --enable-source-maps dist/apps/mission-worker/src/main.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
