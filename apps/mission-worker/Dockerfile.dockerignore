# Dependencies (installed in Docker)
node_modules
**/node_modules

# Build outputs (built in Docker)
**/dist
**/.turbo

# Git
.git
.gitignore
.gitmodules

# IDE
.cursor
.claude
.vscode
**/.DS_Store

# Environment files (secrets passed as env vars)
.env
**/.env
**/.env.*
!**/.env.example

# Logs
*.log
**/*.log

# Test files
**/__tests__
**/*.test.ts
**/*.spec.ts
**/test

# Documentation (not needed in image)
.docs
docs
*.md
!docker/agents/**/*.md

