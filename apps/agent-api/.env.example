# Agent Backend Environment Variables
# Copy to .env and fill in values
#
# ROAS local dev: after copying, run:
#   bash scripts/roas/sync-local-agent-env.sh
#   bash scripts/roas/verify-local-env-alignment.sh

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vault token encryption
# Must match apps/api/.env because admin subscription tokens are written by API and read by Agent API.
VAULT_ENCRYPTION_KEY=64-character-hex-key

# OpenClaw Gateway
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_GATEWAY_TOKEN=your-gateway-token
OPENCLAW_CONFIG_PATH=../../docker/openclaw.json
AGENTS_BASE_DIR=../../docker/agents
PROJECTS_BASE_DIR=../../.runtime/user-projects

# Google Gemini (fallback for image/video when Replicate fails; also used by brain embeddings)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY_FALLBACK=
GEMINI_API_KEY_FALLBACK_2=
OPENCLAW_AGENT_ID=main
OPENCLAW_SESSIONS_DIR=~/.openclaw/agents/vibey/sessions

# Main API (for proxied integration calls like GitHub)
MAIN_API_URL=http://localhost:3001
INTERNAL_API_TOKEN=your-internal-api-token

# Hosted Vibey MCP
MCP_RESOURCE_URL=https://mcp.vibey.im
MCP_OAUTH_ISSUER_URL=http://localhost:3001
MCP_DEV_SUPABASE_JWT_AUTH=false
VIBEY_DOCS_BASE_URL=http://localhost:3011

# Composio
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=

# Agent Definitions Sync (set by Docker / Fly.io)
USER_ID=
AGENTS_BASE_DIR=/app/agents

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_AI_RECORD_INPUTS=false
SENTRY_AI_RECORD_OUTPUTS=false

# Server
PORT=3003
CORS_ORIGIN=http://localhost:3000

# Brain retrieval strategy (chat preload + /api/brain/search)
BRAIN_LLM_RERANKER=1
BRAIN_LLM_RERANKER_MODEL=google/gemini-3.5-flash
BRAIN_MULTI_QUERY_RETRIEVAL=1
BRAIN_EVIDENCE_CHUNKS=1

# Brain eval retrieval probe (POST /api/internal/brain-eval/probe)
# Required for user-work eval to verify retrieval surfaced source facts
BRAIN_EVAL_PROBE_ENABLED=1
