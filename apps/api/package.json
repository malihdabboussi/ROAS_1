{
  "name": "@vibey/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @vibey/agent-policy build && pnpm --filter @vibey/api-shared build && nest start --watch",
    "build": "nest build",
    "start": "node --enable-source-maps dist/main",
    "start:prod": "node --enable-source-maps dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "sync:capabilities": "nest build && node scripts/sync-capabilities.js"
  },
  "dependencies": {
    "@composio/core": "^0.11.0",
    "@google/genai": "^1.42.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/throttler": "^6.0.0",
    "@octokit/auth-app": "^8.2.0",
    "@sendgrid/client": "^8.1.6",
    "@sendgrid/eventwebhook": "^8.0.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/nestjs": "^10.44.0",
    "@sentry/node": "^10.42.0",
    "@supabase/supabase-js": "^2.49.1",
    "@vibey/agent-policy": "workspace:*",
    "@vibey/api-shared": "workspace:*",
    "bullmq": "^5.34.8",
    "cron-parser": "^4.9.0",
    "dotenv": "^17.3.1",
    "esbuild": "^0.28.0",
    "express": "^4.21.0",
    "jose": "^5.10.0",
    "mammoth": "^1.11.0",
    "modal": "^0.7.4",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "1.1.1",
    "pg": "^8.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.3",
    "sharp": "^0.34.5",
    "stripe": "^20.3.1",
    "unpdf": "^1.4.0",
    "xlsx": "^0.18.5",
    "youtube-transcript-api-js": "^3.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.14",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.12.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.18.0",
    "supertest": "^7.2.2",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^2.1.9"
  }
}
