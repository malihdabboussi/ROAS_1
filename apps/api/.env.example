# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
# Direct Postgres (optional; PostgresDirectService — advisory locks, admin mission log aggregates / daily subtask SQL)
# First match wins: SUPABASE_DIRECT_DB_URL, SUPABASE_DB_URL, DATABASE_URL (see packages/api-shared PostgresDirectService)
# Local: either paste here or rely on second env file load below (apps/mission-worker/.env is merged after this file; only fills missing keys)
# SUPABASE_DIRECT_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# OpenClaw Gateway
OPENCLAW_GATEWAY_URL=http://your-vm-ip:18789
OPENCLAW_GATEWAY_TOKEN=your-gateway-token
# Local agent-api sync fallback (used when Fly VM is not running)
AGENT_API_URL=http://localhost:3003

# OpenAI Codex admin OAuth
# Vault token encryption. Must match Agent API because admin subscription tokens are
# written by API and read by Agent API.
VAULT_ENCRYPTION_KEY=64-character-hex-key
# Optional explicit state secret. If omitted, the backend derives an OpenAI-only
# OAuth state signer from VAULT_ENCRYPTION_KEY, which is required for token storage.
OPENAI_CODEX_OAUTH_STATE_SECRET=your-random-state-secret

# SendGrid (domain auth, email sending)
SENDGRID_API_KEY=your-sendgrid-api-key

# GoHighLevel OAuth (must NOT include "ghl" or "highlevel" in redirect URI path)
# Example redirect (local): http://localhost:3001/api/integrations/lhg/callback
GHL_OAUTH_CLIENT_ID=your-ghl-oauth-client-id
GHL_OAUTH_CLIENT_SECRET=your-ghl-oauth-client-secret
GHL_OAUTH_REDIRECT_URI=http://localhost:3001/api/integrations/lhg/callback
GHL_OAUTH_STATE_SECRET=your-random-state-secret

# GitHub App (create at github.com/settings/apps)
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY=your-github-app-private-key-pem
GITHUB_APP_CLIENT_ID=your-github-app-client-id
GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret
GITHUB_APP_WEBHOOK_SECRET=your-github-app-webhook-secret
GITHUB_APP_SLUG=vibey
GITHUB_OAUTH_STATE_SECRET=your-random-state-secret

# Stripe (billing, credits, auto-recharge)
# Get webhook secret from: stripe listen --forward-to localhost:3001/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Stripe Connect OAuth
STRIPE_CONNECT_CLIENT_ID=your-stripe-connect-client-id
STRIPE_CONNECT_SECRET_KEY=your-stripe-connect-secret-key
STRIPE_CONNECT_REDIRECT_URI=http://localhost:3001/api/integrations/stripe/callback
STRIPE_CONNECT_STATE_SECRET=your-random-state-secret

# Meta (Facebook) Ads
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_OAUTH_REDIRECT_URI=http://localhost:3001/api/integrations/meta/callback
META_OAUTH_STATE_SECRET=your-random-state-secret
META_WEBHOOK_VERIFY_TOKEN=your-random-webhook-verify-token
META_WEBHOOK_CALLBACK_URL=https://api.govibey.com/api/integrations/meta/webhook

# Slack OAuth + Events API
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_OAUTH_REDIRECT_URI=http://localhost:3001/api/slack/oauth/callback
SLACK_OAUTH_STATE_SECRET=your-random-state-secret

# Firecrawl (website branding extraction)
FIRECRAWL_API_KEY=your-firecrawl-api-key

# OpenRouter (AI image style generation)
OPENROUTER_API_KEY=your-openrouter-api-key

# Composio
COMPOSIO_API_KEY=your-composio-api-key
# Optional override; defaults to Composio hosted API
COMPOSIO_BASE_URL=

# Social Analysis / scrapecreators API (social scraping for agents)
SCRAPECREATORS_API_KEY=your-scrapecreators-api-key

# Ads research — TikTok/Meta/Google ad libraries via SearchAPI.io
SEARCHAPI_API_KEY=your-searchapi-api-key

# Calendly OAuth
CALENDLY_CLIENT_ID=your-calendly-client-id
CALENDLY_CLIENT_SECRET=your-calendly-client-secret
CALENDLY_REDIRECT_URI=http://localhost:3001/api/integrations/calendly/callback
CALENDLY_OAUTH_STATE_SECRET=your-random-state-secret
CALENDLY_WEBHOOK_SIGNING_KEY=your-calendly-webhook-signing-key

# Fathom OAuth (prod callback — Fathom rejects localhost redirects)
FATHOM_CLIENT_ID=your-fathom-client-id
FATHOM_CLIENT_SECRET=your-fathom-client-secret
FATHOM_REDIRECT_URI=https://api.roas.io/api/integrations/fathom/callback
FATHOM_OAUTH_STATE_SECRET=your-random-state-secret

# Supabase OAuth (for Spaces Projects — users connect their own Supabase accounts)
SUPABASE_OAUTH_CLIENT_ID=your-supabase-oauth-client-id
SUPABASE_OAUTH_CLIENT_SECRET=your-supabase-oauth-client-secret
SUPABASE_OAUTH_REDIRECT_URI=http://localhost:3001/api/integrations/supabase/callback
SUPABASE_OAUTH_STATE_SECRET=your-random-state-secret

# Higgsfield MCP OAuth (public PKCE client; no client secret)
HIGGSFIELD_OAUTH_CLIENT_ID=your-higgsfield-public-client-id
HIGGSFIELD_OAUTH_REDIRECT_URI=http://localhost:3001/api/integrations/higgsfield/callback
HIGGSFIELD_OAUTH_STATE_SECRET=your-random-state-secret

# Sentry
SENTRY_DSN=

# App
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# Unit economics — Vercel Sandbox (default: list CPU/memory per-second × SANDBOX_CPU_CORES / SANDBOX_MEMORY_GIB; min 0.125 vCPU billed)
# SANDBOX_MACHINE_HOURLY_RATE=
# SANDBOX_CPU_USD_PER_CORE_SEC=0.00003942
# SANDBOX_MEMORY_USD_PER_GIB_SEC=0.00000672
# SANDBOX_CPU_CORES=1
# SANDBOX_MEMORY_GIB=4

# Modal (Sandbox runtime for Spaces Projects)
MODAL_TOKEN_ID=your-modal-token-id
MODAL_TOKEN_SECRET=your-modal-token-secret
MODAL_APP_NAME=vibey-spaces-staging
# Directory snapshot from scripts/modal-build-project-template.ts (pnpm install + snapshot /project)
MODAL_SPACES_PROJECT_TEMPLATE_IMAGE_ID=

# Vercel — Spaces Project publishing (deploys user apps to a separate Vercel team)
# Falls back to VERCEL_TOKEN / VERCEL_TEAM_ID if the APPS-specific vars are not set
VERCEL_APPS_TOKEN=your-vercel-apps-team-token
VERCEL_APPS_TEAM_ID=your-vercel-apps-team-id
VERCEL_APPS_PROJECT_PREFIX=vibey-app-
PLATFORM_API_URL=https://api.govibey.com
APPS_DOMAIN_SUFFIX=-app.govibey.com
VIBEY_SESSION_KEY=your-session-key

INTERNAL_API_TOKEN=your-internal-api-token

# Hosted Vibey MCP OAuth
MCP_OAUTH_ISSUER_URL=http://localhost:3001
MCP_RESOURCE_URL=https://mcp.vibey.im
MCP_WEB_CONSENT_URL=http://localhost:3000/mcp/consent
MCP_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_REFRESH_TOKEN_TTL_SECONDS=2592000
MCP_AUTH_CODE_TTL_SECONDS=600

# Queue worker (Railway / production). When missing, drive sync runs inline (dev fallback).
# QUEUE_WORKER_URL=https://your-queue-worker.railway.app

# Fly.io machine pool (warm pool of pre-stopped machines for fast provision)
MACHINE_POOL_REPLENISH_ENABLED=true
MACHINE_POOL_SIZE=3
MACHINE_IDLE_THRESHOLD_MS=900000
MACHINE_STALE_THRESHOLD_DAYS=30
FLY_MACHINE_HOURLY_RATE=0.0226
