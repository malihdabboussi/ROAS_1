{
  "version": 2,
  "buildCommand": "bash scripts/vercel-build.sh",
  "installCommand": "cd ../.. && npx pnpm@9 install --no-frozen-lockfile",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{public/**,dist/**,node_modules/@vibey/**,../../packages/@vibey/**,../../docker/agents/templates/**}"
    },
    "api/space-automation-cron.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/cron/space-automations", "destination": "/api/space-automation-cron" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    {
      "path": "/api/machines/idle-check",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/machines/pool-replenish",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/admin/billing-health/reconcile",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/cron/space-automations",
      "schedule": "1-4,6-9,11-14,16-19,21-24,26-29,31-34,36-39,41-44,46-49,51-54,56-59 * * * *"
    }
  ]
}
