{
  "version": 2,
  "buildCommand": "bash scripts/vercel-build.sh",
  "installCommand": "cd ../.. && npx pnpm@9 install --no-frozen-lockfile",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{public/**,node_modules/@vibey/api-shared/**,node_modules/@vibey/agent-policy/**,../../node_modules/@vibey/api-shared/**,../../node_modules/@vibey/agent-policy/**,../../packages/api-shared/**,../../packages/agent-policy/**,../../packages/@vibey/api-shared/**,../../packages/@vibey/agent-policy/**,../../docker/agents/templates/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [
    {
      "path": "/api/machines/idle-check",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/machines/pool-replenish",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/admin/billing-health/reconcile",
      "schedule": "0 2 * * *"
    }
  ]
}
