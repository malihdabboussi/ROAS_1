# Offer PDF footer link (default https://vibey.im). Prefer:
# NEXT_PUBLIC_VIBEY_PLATFORM_URL=https://vibey.im
# NEXT_PUBLIC_GOVIBEY_URL=https://vibey.im

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API — Platform (Railway)
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Backend API — Agent (VM with OpenClaw)
AGENT_BACKEND_URL=http://localhost:3003

# Hosted Vibey MCP
NEXT_PUBLIC_MCP_CONSENT_PATH=/mcp/consent

# Public Agent Pages — shared secret with Cloudflare Worker (govibey.com)
WORKER_SECRET=

# Waitlist mode (set to 'true' to block /register and require invite codes)
NEXT_PUBLIC_WAITLIST_MODE=true

# Staging-only: when 'true', middleware allows only user_profiles.role === 'admin' on dashboard/onboarding/auth redirects.
# Set on Vercel Preview (staging branch / staging domain only). Leave unset or false in Production.
NEXT_PUBLIC_REQUIRE_ADMIN=false

# ROAS / staging: show "Continue for free" on onboarding subscribe step (requires API ALLOW_FREE_ONBOARDING=true).
NEXT_PUBLIC_ALLOW_FREE_ONBOARDING=false

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
